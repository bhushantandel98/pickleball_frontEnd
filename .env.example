# Environment configuration template
# Copy to .env.local for local overrides. Do not commit actual secrets to version control.

# Application Environment (development | staging | production)
APP_ENV=development

# API Base URL
API_BASE_URL=https://api-dev.pickleballplatform.com/api/v1

# Use Mock Repositories (true | false)
USE_MOCKS=true

# Request Timeout (milliseconds)
API_TIMEOUT_MS=15000
